generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  sections      Section[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Section {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  title          String
  purpose        String       @default("other")
  description    String?
  theme          String
  layoutType     String
  backgroundUrl  String?
  customCssUrl   String?
  content        Json?
  isPublic       Boolean      @default(false)
  shareSlug      String?      @unique
  images         Image[]
  stickyNotes    StickyNote[]
  
  // Custom Journey Connections
  linkedToId     String?
  linkedTo       Section?     @relation("JourneyLinks", fields: [linkedToId], references: [id])
  linkedFrom     Section[]    @relation("JourneyLinks")

  createdAt      DateTime     @default(now())
}

model Image {
  id           String   @id @default(cuid())
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id])
  originalUrl  String              // full HD, R2 key
  displayUrl   String              // ~1600px WebP, used for normal viewing
  thumbUrl     String              // ~400px WebP, used in grids
  takenAt      DateTime?           // from EXIF
  uploadedAt   DateTime @default(now())
  width        Int
  height       Int
  position     Int      @default(0)
  // Scrapbook editor position (percentage-based)
  scrapX       Float?
  scrapY       Float?
  scrapRotate  Float?
  notes        Note[]
}

model Note {
  id          String  @id @default(cuid())
  imageId     String
  image       Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  text        String
  x           Float              // percentage position, 0-100
  y           Float
  color       String  @default("#1a1a1a")
  fontFamily  String  @default("serif")
  fontSize    Int     @default(14)
  isBold      Boolean @default(false)
  isItalic    Boolean @default(true)
  isUnderline Boolean @default(false)
}

model StickyNote {
  id          String  @id @default(cuid())
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text        String  @default("Write here...")
  x           Float   @default(50)   // percentage position
  y           Float   @default(50)
  color       String  @default("#fef08a") // yellow sticky note
  fontFamily  String  @default("serif")
  fontSize    Int     @default(14)
  isBold      Boolean @default(false)
  isItalic    Boolean @default(true)
  isUnderline Boolean @default(false)
  page        Int     @default(1)     // which scrapbook spread page
  createdAt   DateTime @default(now())
}
