generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Two roles today. If granular permissions are ever needed (say a support role
// that can view albums but not delete them), this enum becomes a Role table
// plus a join, and the admin helpers keep the same signatures.
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Privilege lives here, not in an env var. It defaults to USER so a new
  // sign-in can never arrive privileged, and only the promote/demote action
  // writes it.
  role          Role      @default(USER)
  roleUpdatedAt DateTime?
  roleUpdatedBy String?
  // Profile, owned by the person rather than by Google. `name` and `image`
  // arrive from the provider on first sign-in and are theirs to change after
  // that; email stays as the provider set it, because it is the identity they
  // sign in with and admin access is matched on it.
  phone         String?
  bio           String?
  location      String?
  accounts      Account[]
  sessions      Session[]
  sections      Section[]
  createdAt     DateTime  @default(now())

  @@index([role])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Section {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  title          String
  purpose        String       @default("other")
  description    String?
  theme          String
  layoutType     String
  backgroundUrl  String?
  customCssUrl   String?
  content        Json?
  isPublic       Boolean      @default(false)
  shareSlug      String?      @unique
  images         Image[]
  stickyNotes    StickyNote[]
  
  // Where this memory happened. Set by dropping a pin on the globe, so these
  // are real coordinates rather than a place name we would have to resolve.
  placeName      String?
  lat            Float?
  lng            Float?

  // Custom Journey Connections
  linkedToId     String?
  linkedTo       Section?     @relation("JourneyLinks", fields: [linkedToId], references: [id])
  linkedFrom     Section[]    @relation("JourneyLinks")

  createdAt      DateTime     @default(now())
}

model Image {
  id           String   @id @default(cuid())
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id])
  originalUrl  String              // full HD, R2 key
  displayUrl   String              // ~1600px WebP, used for normal viewing
  thumbUrl     String              // ~400px WebP, used in grids
  takenAt      DateTime?           // from EXIF
  uploadedAt   DateTime @default(now())
  width        Int
  height       Int
  position     Int      @default(0)
  // Scrapbook editor position (percentage-based)
  scrapX       Float?
  scrapY       Float?
  scrapRotate  Float?
  notes        Note[]
}

model Note {
  id          String  @id @default(cuid())
  imageId     String
  image       Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  text        String
  x           Float              // percentage position, 0-100
  y           Float
  color       String  @default("#1a1a1a")
  fontFamily  String  @default("serif")
  fontSize    Int     @default(14)
  isBold      Boolean @default(false)
  isItalic    Boolean @default(true)
  isUnderline Boolean @default(false)
}

model StickyNote {
  id          String  @id @default(cuid())
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text        String  @default("Write here...")
  x           Float   @default(50)   // percentage position
  y           Float   @default(50)
  color       String  @default("#fef08a") // yellow sticky note
  fontFamily  String  @default("serif")
  fontSize    Int     @default(14)
  isBold      Boolean @default(false)
  isItalic    Boolean @default(true)
  isUnderline Boolean @default(false)
  page        Int     @default(1)     // which scrapbook spread page
  createdAt   DateTime @default(now())
}
